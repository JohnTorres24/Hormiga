<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/surface_bottom_sheet"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Barra de agarre -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/divider_color"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar Nueva Suscripción"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura tu servicio para activar las alertas y el análisis anual"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Nombre -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nombre del Servicio (ej. Netflix 4K, Spotify)"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/primary"
            app:boxStrokeColor="@color/primary"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSubName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Proveedor -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Proveedor (ej. Netflix, OpenAI, Smart Fit)"
            android:textColorHint="@color/text_secondary"
            app:hintTextColor="@color/primary"
            app:boxStrokeColor="@color/primary"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSubProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Precio y Moneda -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="Precio Cobrado"
                android:textColorHint="@color/text_secondary"
                app:hintTextColor="@color/primary"
                app:boxStrokeColor="@color/primary"
                android:layout_marginEnd="8dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSubPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggleSubCurrency"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                app:singleSelection="true">

                <Button
                    android:id="@+id/btnSubCOP"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COP"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnSubUSD"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USD"
                    android:textSize="11sp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </LinearLayout>

        <!-- Ciclo de Facturación -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ciclo de facturación:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <RadioGroup
            android:id="@+id/rgBillingCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbMonthly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mensual"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <RadioButton
                android:id="@+id/rbYearly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anual"
                android:textSize="12sp"
                android:layout_marginEnd="12dp" />

            <RadioButton
                android:id="@+id/rbWeekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Semanal"
                android:textSize="12sp" />
        </RadioGroup>

        <!-- Próxima Fecha de Cobro -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickNextBillingDate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar Próxima Fecha de Cobro"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Checkbox Prueba Gratuita -->
        <CheckBox
            android:id="@+id/cbIsFreeTrial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Es una prueba gratuita (Free Trial)?"
            android:textColor="@color/primary"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <!-- Fecha fin de prueba -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickTrialEndDate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fecha Límite de Prueba (Alerta 48h)"
            android:visibility="gone"
            android:textColor="@color/rose_danger"
            android:textSize="13sp"
            android:layout_marginBottom="12dp" />

        <!-- Frecuencia de Uso & Valor Percibido -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cazador de Gastos Hormiga (Calificación):"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvRatingLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Utilidad: 3★"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderPerceivedValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:valueFrom="1.0"
                android:valueTo="5.0"
                android:stepSize="1.0"
                android:value="3.0" />
        </LinearLayout>

        <!-- Botón Guardar con Texto e Icono Blanco Nítido -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveSubscription"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Guardar Suscripción"
            android:textColor="@color/text_on_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary"
            app:icon="@drawable/ic_add"
            app:iconTint="@color/text_on_dark"
            app:iconGravity="textStart"
            app:cornerRadius="14dp" />

    </LinearLayout>
</ScrollView>
